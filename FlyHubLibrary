local mainFrame = Window:GetMainFrame()
-- Redupkan gambar latar agar tulisan lebih terbaca.
-- Hanya menargetkan gambar besar, bukan ikon kecil.
local function dimBackground(object)
    if not object:IsA("ImageLabel") then
        return
    end

    local frameSize = mainFrame.AbsoluteSize
    local imageSize = object.AbsoluteSize

    if frameSize.X <= 0 or frameSize.Y <= 0 then
        return
    end

    if imageSize.X >= frameSize.X * 0.75
        and imageSize.Y >= frameSize.Y * 0.75 then
        object.ImageColor3 = Color3.fromRGB(100, 100, 100)
    end
end

task.defer(function()
    if not alive then return end

    for _, object in ipairs(mainFrame:GetDescendants()) do
        dimBackground(object)
    end
end)
local screenGui = mainFrame:FindFirstAncestorOfClass("ScreenGui")
local uiRoot = screenGui or mainFrame
local styled = setmetatable({}, {__mode = "k"})

local function styleObject(object)
    if not alive or styled[object] then
        return
    end
    styled[object] = true

    if object:IsA("TextLabel")
        or object:IsA("TextButton")
        or object:IsA("TextBox") then

        -- Pertahankan perbedaan ketebalan font dari library.
        local weight = object.FontFace.Weight
        local bold = weight == Enum.FontWeight.Bold
            or weight == Enum.FontWeight.SemiBold
            or weight == Enum.FontWeight.Heavy

        object.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham

        -- Gold terang + outline gelap agar terbaca di atas gambar.
        object.TextColor3 = Color3.fromRGB(255, 224, 150)
        object.TextTransparency = 0
        object.TextStrokeColor3 = Color3.fromRGB(10, 7, 2)
        object.TextStrokeTransparency = 0.2
    end
    
    if object:IsA("TextBox") then
        object.PlaceholderColor3 = Color3.fromRGB(205, 184, 135)
    end

    if object:IsA("GuiButton") then
        track(object.MouseEnter:Connect(function()
            playSound("Hover")
        end))

        track(object.Activated:Connect(function()
            playSound("Click")
        end))
    end
end

track(uiRoot.DescendantAdded:Connect(function(object)
    task.defer(function()
        if alive and object:IsDescendantOf(uiRoot) then
            styleObject(object)
        end
    end)
end))

for _, object in ipairs(uiRoot:GetDescendants()) do
    styleObject(object)
end

-- Efek ketika window disembunyikan / ditampilkan.
track(mainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
    playSound(mainFrame.Visible and "Open" or "Close")
end))

-- Bersihkan audio jika window dihancurkan oleh library.
track(mainFrame.Destroying:Connect(function()
    if alive then
        task.defer(cleanup)
    end
end))

