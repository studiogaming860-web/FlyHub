}

local DefaultIcons = {
    CreateButton = Icons.Play,
    CreateToggle = Icons.Power,
    CreateDropdown = Icons.Dropdown,
    CreateSection = Icons.Star,
    CreateParagraph = Icons.Star,
}

local originalCreateTab = Window.CreateTab

function Window:CreateTab(options)
    local tabOptions = table.clone(options or {})

    if not tabOptions.Icon or tabOptions.Icon == "" then
        tabOptions.Icon = Icons[tabOptions.Title] or Icons.Extra
    end

    local tab = originalCreateTab(self, tabOptions)

    for methodName, defaultIcon in pairs(DefaultIcons) do
        local originalMethod = tab[methodName]
        local fallbackIcon = defaultIcon

        if type(originalMethod) == "function" then
            tab[methodName] = function(self, componentOptions)
                local opts = table.clone(componentOptions or {})

                -- Icon manual selalu diprioritaskan.
                if not opts.Icon or opts.Icon == "" then
                    opts.Icon = TitleIcons[opts.Title] or fallbackIcon
                end

                return originalMethod(self, opts)
            end
        end
    end

    -- Slider tidak memiliki opsi Icon di dokumentasi.
    -- Gunakan simbol pada judul agar tetap ada penanda visual.
    local originalSlider = tab.CreateSlider

    if type(originalSlider) == "function" then
        tab.CreateSlider = function(self, componentOptions)
            local opts = table.clone(componentOptions or {})
            opts.Title = "≡  " .. (opts.Title or "Slider")
            return originalSlider(self, opts)
        end
    end

    return tab
end

