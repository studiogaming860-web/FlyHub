--========================================================
-- LOAD & RUNTIME
--========================================================

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local SoundService = game:GetService("SoundService")
local Env = type(getgenv) == "function" and getgenv() or _G

local function asset(value)
    local id = tostring(value or "")
    if id == "" or id == "0" then
        return ""
    end
    if id:match("^%d+$") then
        return "rbxassetid://" .. id
    end
    return id
end

local loaded, ProxyLib = pcall(function()
    local source = game:HttpGet(
        "https://raw.githubusercontent.com/ProxyHubDev/ProxyLib/refs/heads/main/Documents/ProxyLibrary"
    )
    local chunk, err = loadstring(source)
    assert(chunk, err)
    return chunk()
end)

if not loaded then
    warn("[FlyHub] Gagal memuat ProxyLib: " .. tostring(ProxyLib))
    return
end

-- Bersihkan template lama saat script dijalankan ulang.
if type(Env.FlyHubCleanup) == "function" then
    local ok, err = pcall(Env.FlyHubCleanup)
    if not ok then
        warn("[FlyHub] Cleanup gagal: " .. tostring(err))
        return
    end
end

local Lib = ProxyLib.new()
local connections = {}
local alive = true

local function track(connection)
    table.insert(connections, connection)
    return connection
end

--========================================================
-- SOUND
--========================================================

local soundFolder = Instance.new("Folder")
soundFolder.Name = "FlyHubAudio"
soundFolder.Parent = SoundService

local sounds = {}
local lastPlayed = {}

local soundStyle = {
    Click = {Pitch = 1.6, Volume = 0.55},
    Hover = {Pitch = 2.0, Volume = 0.15},
    Open = {Pitch = 1.15, Volume = 0.65},
    Close = {Pitch = 0.85, Volume = 0.45},
    Notification = {Pitch = 1.3, Volume = 0.8},
}

for name, style in pairs(soundStyle) do
    local sound = Instance.new("Sound")
    sound.Name = name
    sound.SoundId = asset(Config.Audio[name])
    sound.PlaybackSpeed = style.Pitch
    sound.Volume = Config.Audio.Volume * style.Volume
    sound.Parent = soundFolder
    sounds[name] = sound
end

local function playSound(name)
    if not alive or not Config.Audio.Enabled then
        return
    end

    local sound = sounds[name]
    if not sound or sound.SoundId == "" then
        return
    end

    -- Hindari suara bertumpuk ketika pointer bergerak cepat.
    local now = os.clock()
    local cooldown = name == "Hover" and 0.12 or 0.06

    if now - (lastPlayed[name] or -math.huge) < cooldown then
        return
    end

    lastPlayed[name] = now
    sound:Stop()
    sound.TimePosition = 0
    sound:Play()
end

--========================================================
-- CLEANUP
--========================================================

local function cleanup()
    if not alive then
        return
    end
    alive = false

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    table.clear(connections)

    soundFolder:Destroy()
    Lib:Destroy()

    if Env.FlyHubCleanup == cleanup then
        Env.FlyHubCleanup = nil
    end

    -- Tambahkan cleanup fitur lu di sini.
end

Env.FlyHubCleanup = cleanup

